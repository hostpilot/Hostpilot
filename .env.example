# Production Site URL
VITE_SITE_URL="https://hostpilot.online"
NEXT_PUBLIC_SITE_URL="https://hostpilot.online"

# Search Engine Verifications
GOOGLE_SITE_VERIFICATION="your_google_site_verification_code"
BING_SITE_VERIFICATION="your_bing_site_verification_code"

# Analytics (Loaded conditionally after user cookie consent)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Email Delivery (Resend API)
RESEND_API_KEY="re_123456789"
CONTACT_TO_EMAIL="Gethostpilot@gmail.com"
CONTACT_FROM_EMAIL="HostPilot Concierge <concierge@hostpilot.online>"

# Cloudflare Turnstile (Optional spam defense)
TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Upstash Redis (Optional per-IP rate limiting)
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
